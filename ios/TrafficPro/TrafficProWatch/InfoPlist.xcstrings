{
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Location permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used on this device to show the commute that starts where you are. Your location is never sent anywhere."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa en este dispositivo para mostrar el trayecto que comienza donde estás. Tu ubicación nunca se envía a ningún lado."
          }
        }
      }
    }
  },
  "sourceLanguage": "en",
  "version": "1.0"
}
